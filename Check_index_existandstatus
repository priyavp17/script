1. Check whether the index exists
IF EXISTS (
    SELECT 1
    FROM sys.indexes
    WHERE object_id = OBJECT_ID('dbo.YourTable')
      AND name = 'IX_YourIndexName'
)
    SELECT 'Index exists' AS Result;
ELSE
    SELECT 'Index does not exist' AS Result;
2. Check whether the index is disabled
SELECT
    i.name AS IndexName,
    OBJECT_NAME(i.object_id) AS TableName,
    i.is_disabled AS IsDisabled,
    CASE
        WHEN i.is_disabled = 1 THEN 'Disabled'
        WHEN i.is_disabled = 0 THEN 'Enabled'
    END AS IndexStatus
FROM sys.indexes i
WHERE i.object_id = OBJECT_ID('dbo.TableName')
  AND i.name = 'IndexName';
SELECT 
    OBJECT_NAME(object_id) AS TableName,
    name                   AS IndexName,
    is_disabled,
    CASE WHEN is_disabled = 1 THEN 'Disabled' ELSE 'Enabled' END AS Status
FROM sys.indexes
WHERE object_id = OBJECT_ID('dbo.YourTable')
  AND name = 'IX_YourIndexName';
